generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id           String       @id @default(uuid())
  name         String
  email        String       @unique
  passwordHash String
  role         Role         @default(VIEWER)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  simulations  Simulation[]

  @@map("users")
}

model Station {
  id                  String                @id @default(uuid())
  name                String
  code                String                @unique
  location            String
  latitude            Float
  longitude           Float
  status              String                @default("ONLINE")
  description         String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  alerts              Alert[]
  batteries           Battery[]
  criticalLoads       CriticalLoad[]
  energyLoads         EnergyLoad[]
  generators          Generator[]
  renewableGeneration RenewableGeneration[]
  simulations         Simulation[]
  weatherData         WeatherData[]

  @@map("stations")
}

model WeatherData {
  id             String   @id @default(uuid())
  stationId      String
  timestamp      DateTime
  temperature    Float
  pressure       Float
  humidity       Float
  windSpeed      Float
  windDirection  String
  solarRadiation Float
  createdAt      DateTime @default(now())
  station        Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([stationId, timestamp])
  @@map("weather_data")
}

model EnergyLoad {
  id                String   @id @default(uuid())
  stationId         String
  timestamp         DateTime
  totalLoad         Float
  heatingLoad       Float
  waterLoad         Float
  communicationLoad Float
  laboratoryLoad    Float
  refrigerationLoad Float
  flexibleLoad      Float
  createdAt         DateTime @default(now())
  station           Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([stationId, timestamp])
  @@map("energy_loads")
}

model RenewableGeneration {
  id             String   @id @default(uuid())
  stationId      String
  timestamp      DateTime
  solarPower     Float
  windPower      Float
  totalRenewable Float
  createdAt      DateTime @default(now())
  station        Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([stationId, timestamp])
  @@map("renewable_generation")
}

model Generator {
  id            String             @id @default(uuid())
  stationId     String
  name          String
  capacity      Float
  minimumOutput Float
  efficiency    Float
  fuelType      String             @default("diesel")
  status        String             @default("STOPPED")
  fuelLevel     Float
  totalRuntime  Float              @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  readings      GeneratorReading[]
  station       Station            @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@map("generators")
}

model GeneratorReading {
  id           String    @id @default(uuid())
  generatorId  String
  timestamp    DateTime
  powerOutput  Float
  fuelConsumed Float
  efficiency   Float
  runtime      Float
  createdAt    DateTime  @default(now())
  generator    Generator @relation(fields: [generatorId], references: [id], onDelete: Cascade)

  @@index([generatorId, timestamp])
  @@map("generator_readings")
}

model Battery {
  id                String           @id @default(uuid())
  stationId         String
  name              String
  capacity          Float
  currentSOC        Float
  minimumSOC        Float            @default(20)
  maximumSOC        Float            @default(95)
  maxChargePower    Float
  maxDischargePower Float
  status            String           @default("IDLE")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  station           Station          @relation(fields: [stationId], references: [id], onDelete: Cascade)
  readings          BatteryReading[]

  @@map("batteries")
}

model BatteryReading {
  id             String   @id @default(uuid())
  batteryId      String
  timestamp      DateTime
  soc            Float
  chargePower    Float
  dischargePower Float
  createdAt      DateTime @default(now())
  battery        Battery  @relation(fields: [batteryId], references: [id], onDelete: Cascade)

  @@index([batteryId, timestamp])
  @@map("battery_readings")
}

model CriticalLoad {
  id           String   @id @default(uuid())
  stationId    String
  name         String
  category     String
  priority     Int
  ratedPower   Float
  currentPower Float
  status       String   @default("ONLINE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  station      Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@map("critical_loads")
}

model Alert {
  id             String    @id @default(uuid())
  stationId      String
  type           String
  severity       String
  title          String
  message        String
  status         String    @default("ACTIVE")
  source         String
  createdAt      DateTime  @default(now())
  acknowledgedAt DateTime?
  station        Station   @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@map("alerts")
}

model Simulation {
  id                     String            @id @default(uuid())
  userId                 String
  stationId              String
  name                   String
  temperature            Float
  windSpeed              Float
  solarAvailability      Float
  occupancy              Int
  batterySOC             Float
  renewableForecastError Float
  generatorFailure       Boolean
  createdAt              DateTime          @default(now())
  result                 SimulationResult?
  station                Station           @relation(fields: [stationId], references: [id], onDelete: Cascade)
  user                   User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("simulations")
}

model SimulationResult {
  id                   String     @id @default(uuid())
  simulationId         String     @unique
  predictedLoad        Float
  renewableGeneration  Float
  batterySOC           Float
  fuelConsumption      Float
  generatorRequirement Float
  energyStress         Boolean
  criticalLoadRisk     Boolean
  recommendation       String
  createdAt            DateTime   @default(now())
  simulation           Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@map("simulation_results")
}

enum Role {
  ADMIN
  OPERATOR
  VIEWER
}
